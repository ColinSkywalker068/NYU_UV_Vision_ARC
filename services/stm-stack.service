[Unit]
Description=STM launch (headless) in CV Docker image
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
WorkingDirectory=/home/ultraviolet/CV_Detection
# Ensure we don't hit interactive docker exec on an old container.
ExecStartPre=-/usr/bin/docker rm -f uv-nyuultraviolet-cv-dockerfile-jp60-pytorch21-humble-tensorrt-realsense-wrapper
ExecStart=/bin/bash -lc '/home/ultraviolet/CV_Detection/services/start-container.sh nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-realsense-wrapper bash -lc "cd /home/ultraviolet/CV_Detection && uv run yolov8_ros stm.launch.safal.py show:=false"'
ExecStop=/usr/bin/docker stop uv-nyuultraviolet-cv-dockerfile-jp60-pytorch21-humble-tensorrt-realsense-wrapper

[Install]
WantedBy=multi-user.target
