[Unit]
Description=STM launch (headless) in CV Docker image
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
WorkingDirectory=/home/ultraviolet/CV_Detection
Environment=CV_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-realsense-wrapper-ultra
Environment=UV_CONTAINER_NAME=uv-stm-stack
# Ensure we do not attach to an older reused container from a previous boot.
ExecStartPre=-/usr/bin/docker rm -f ${UV_CONTAINER_NAME}
ExecStart=/bin/bash -lc "/home/ultraviolet/CV_Detection/services/start-container.sh ${CV_IMAGE} bash -lc 'cd /home/ultraviolet/CV_Detection && uv run yolov8_ros stm.launch.py show:=false'"
ExecStop=-/usr/bin/docker stop ${UV_CONTAINER_NAME}

[Install]
WantedBy=multi-user.target
