[Unit]
Description=STM launch (headless) in CV Docker image
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
WorkingDirectory=/home/ultraviolet/CV_Detection
TimeoutStopSec=20
Environment=CV_STM_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-cplusplus-pylon
Environment=UV_CONTAINER_NAME=cv-stm-stack
EnvironmentFile=-/etc/cv-detection/stm-stack.env
# Ensure startup always uses the latest mounted workspace and env file.
ExecStartPre=-/bin/bash -lc '/usr/bin/docker rm -f "${UV_CONTAINER_NAME:-cv-stm-stack}"'
ExecStart=/bin/bash -lc 'UV_CONTAINER_NAME="${UV_CONTAINER_NAME:-cv-stm-stack}" /home/ultraviolet/CV_Detection/services/start-container.sh "${CV_STM_IMAGE:-nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-cplusplus-pylon}" bash -lc "cd /home/ultraviolet/CV_Detection && exec ./services/stm-stack-entrypoint.sh run"'
ExecStop=-/bin/bash -lc '/usr/bin/docker stop "${UV_CONTAINER_NAME:-cv-stm-stack}"'

[Install]
WantedBy=multi-user.target
