[Unit]
Description=UV Docker Stack Service
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=always
Environment=CV_BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-cplusplus
Environment=DOCKER_BUILDKIT=1
Environment=COMPOSE_DOCKER_CLI_BUILD=1
ExecStartPre=docker compose -f /home/ultraviolet/CV_Detection/Docker/docker-compose.yml build
ExecStart=docker compose -f /home/ultraviolet/CV_Detection/Docker/docker-compose.yml up --remove-orphans
          
[Install]
WantedBy=multi-user.target
