# Safe example for /etc/cv-detection/stm-stack.env.
# This file is tracked for documentation. The service reads the copy under /etc.
# Install it only when creating a new machine configuration:
#   sudo install -D -m 0644 services/stm-stack.env.example /etc/cv-detection/stm-stack.env
#
# SAFETY: keep transmit_enable:=false and enable_fire_recommendation:=false for
# preview-only operation. Fire recommendations require explicit human opt-in.
# Real controller-facing SP movement transmission requires BOTH:
#   solver_output_mode:=absolute
#   transmit_enable:=true
# The Type C firmware must also accept vision control. See
# docs/project/stm-stack-config.md before enabling transmission.

CV_STM_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-cplusplus-pylon
UV_CONTAINER_NAME=cv-stm-stack
CV_STM_LAUNCH_PROFILE=basler

# Keep the ROS graph local to this robot unless remote ROS access is intentional.
ROS_DOMAIN_ID=37
ROS_LOCALHOST_ONLY=1

# Detector/model configuration.
CV_STM_MODEL_PATH=/home/ultraviolet/CV_Detection/yolo_cpp/models/kushalv2.engine
CV_STM_DETECTOR_BACKEND=deepstream
CV_STM_ALLOW_NATIVE_TENSORRT_FALLBACK=false
CV_STM_TARGET_COLOR=blue
CV_STM_USE_MODEL_COLOR_CLASSES=true
# CV_STM_ENABLE_COLOR_VERIFICATION=false

# STM32 serial receive is enabled for attitude telemetry; command TX remains off below.
CV_STM_SERIAL_PORT=/dev/ttyACM0
CV_STM_REQUIRE_SERIAL=false

# Camera and preview configuration.
CV_STM_BASLER_FPS=160
CV_STM_BASLER_UNCAPPED_FPS=false
CV_STM_BASLER_FLIP=false
CV_STM_PREVIEW_MAX_FPS=60.0
# Values: web, gui, or false. Web preview listens on port 8080.
CV_STM_SHOW=web

# Safe absolute-command preview:
# - computes absolute commands from received attitude,
# - draws command/current/error and the direction arrow,
# - does not transmit movement packets while transmit_enable:=false.
CV_STM_EXTRA_LAUNCH_ARGS="use_3d_solution:=false publish_zero_angles_when_no_target:=false enable_fire_recommendation:=false solver_output_mode:=absolute preview_command_is_offset:=false preview_absolute_error_arrow:=true transmit_enable:=false receive_enable:=true"

# Optional target-frame capture.
# CV_STM_SAVE_TARGET_FRAMES=false
# CV_STM_TARGET_FRAME_SAVE_DIR=
# CV_STM_TARGET_FRAME_SAVE_MAX=100
# CV_STM_TARGET_FRAME_JPEG_QUALITY=85

# Optional RealSense profile.
# CV_STM_LAUNCH_PROFILE=realsense
# CV_STM_REQUIRE_SERIAL=false
# CV_STM_REALSENSE_WIDTH=640
# CV_STM_REALSENSE_HEIGHT=480
# CV_STM_REALSENSE_FPS=60
