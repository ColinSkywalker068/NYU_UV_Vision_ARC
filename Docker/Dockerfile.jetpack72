FROM nvcr.io/nvidia/deepstream:9.1-samples-multiarch
ENV DEBIAN_FRONTEND=noninteractive ROS_DISTRO=jazzy CV_STM_ROS_DISTRO=jazzy
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg build-essential cmake git pkg-config \
    python3-yaml python3-numpy \
    python3-onnx libopencv-dev libeigen3-dev libyaml-cpp-dev libusb-1.0-0-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    libgtkmm-3.0-1t64 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --silent --show-error --location \
    https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && printf '%s\n' 'deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main' \
    > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base ros-jazzy-ament-cmake-gtest ros-jazzy-ament-cmake-pytest \
    ros-jazzy-cv-bridge ros-jazzy-rclcpp-components ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-visualization-msgs ros-jazzy-tf2-ros \
    && rm -rf /var/lib/apt/lists/*
# Match Ramon's installed JetPack SDK; do not let apt select TensorRT 11.
ARG TRT_VERSION=10.16.2.10-1+cuda13.2
RUN apt-get update && apt-get install -y --no-install-recommends --allow-change-held-packages \
    python3-colcon-common-extensions python3-vcstool \
    cuda-nvcc-13-2 cuda-cudart-dev-13-2 \
    libnvinfer-headers-dev=${TRT_VERSION} \
    libnvinfer-headers-plugin-dev=${TRT_VERSION} \
    tensorrt-libs=${TRT_VERSION} libnvinfer10=${TRT_VERSION} libnvinfer-plugin10=${TRT_VERSION} \
    libnvinfer-lean10=${TRT_VERSION} libnvinfer-dispatch10=${TRT_VERSION} \
    libnvinfer-vc-plugin10=${TRT_VERSION} libnvonnxparsers10=${TRT_VERSION} \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/ros/jazzy/bin:/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/opt/nvidia/deepstream/deepstream/lib:${LD_LIBRARY_PATH}
WORKDIR /workspace
ENTRYPOINT []
CMD ["/bin/bash"]
