ARG BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt

FROM ${BASE_IMAGE}

# Install Python
RUN apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev && apt-get update && apt-get clean all

# Install basic dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
	    libssl-dev \
	    libusb-1.0-0-dev \
        libgtk-3-dev \
        libglfw3-dev \
	    libgl1-mesa-dev \
	    libglu1-mesa-dev \
	    libusb-1.0-0 \
        udev \
        apt-transport-https \
        ca-certificates \
        curl \
        software-properties-common \
	    qtcreator && \
    rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Realsense Library
# https://github.com/IntelRealSense/librealsense/issues/11931
ARG LIBREALSENSE_VERSION=development
RUN git clone --branch ${LIBREALSENSE_VERSION} --depth=1 https://github.com/IntelRealSense/librealsense && \
    cd librealsense && \
    mkdir build && \
    cd build && \
    cmake \
        -DBUILD_EXAMPLES=true \
	   -DFORCE_RSUSB_BACKEND=true \
	   -DBUILD_WITH_CUDA=true \
	   -DCMAKE_BUILD_TYPE=release \
	   -DBUILD_PYTHON_BINDINGS=bool:true \
	   -DPYTHON_EXECUTABLE=/usr/bin/python3 \
	   ../ && \
    make -j$(($(nproc)-1)) && \
    make install && \
    cd ../ && \
    cp -r . /usr/local/ && \
    cp ./config/99-realsense-libusb.rules /etc/udev/rules.d/ && \
    cp ./config/99-realsense-d4xx-mipi-dfu.rules /etc/udev/rules.d/ && \
    rm -rf librealsense

ENV PYTHONPATH=${PYTHONPATH}:/usr/local/lib

ENV DEBIAN_FRONTEND=noninteractive

# Realsense ROS: https://github.com/IntelRealSense/realsense-ros/tree/ros2-development
ENV WS_DIR="/ros2_ws"
WORKDIR ${WS_DIR}
RUN apt-get update -y \
 && mkdir src \
 && cd src \
 && git clone https://github.com/IntelRealSense/realsense-ros.git -b ros2-development \
 && cd .. \
 && apt-get install -y python3-rosdep \
 && source /opt/ros/${ROS_DISTRO}/install/setup.bash \
 && rm /etc/ros/rosdep/sources.list.d/20-default.list \
 && rosdep init \
 && rosdep update \
 && rosdep install -i --from-path src --rosdistro ${ROS_DISTRO} --skip-keys=librealsense2 -y \
 && source /opt/ros/${ROS_DISTRO}/setup.bash \
 && colcon build
RUN source ./install/local_setup.sh

# YOLOv8 ROS
ENV WS_DIR_YOLOV8="/ros2_yolov8_ws"
WORKDIR ${WS_DIR_YOLOV8}
RUN apt-get update -y \
 && mkdir src \
 && cd src \
 && git clone https://github.com/mgonzs13/yolov8_ros.git \
 && pip3 install ultralytics --no-cache-dir --no-deps \
 && pip3 install --no-cache-dir py-cpuinfo psutil scipy seaborn thop tqdm pandas onnxsim \
 && pip3 install --no-cache-dir --upgrade matplotlib gitpython \
 && cd .. \
 && source /opt/ros/${ROS_DISTRO}/install/setup.bash \
 && rm /etc/ros/rosdep/sources.list.d/20-default.list \
 && rosdep init \
 && rosdep update \
 && rosdep install --from-paths src --ignore-src -r -y \
 && source /opt/ros/${ROS_DISTRO}/setup.bash \
 && colcon build
RUN source ${WS_DIR_YOLOV8}/install/local_setup.sh

# MicroROS
ENV WS_DIR_MICROROS="/ros2_micro_ws"
WORKDIR ${WS_DIR_MICROROS}
RUN apt-get update -y \
 && mkdir src \
 && cd src \
 && git clone -b $ROS_DISTRO https://github.com/micro-ROS/micro_ros_setup.git src/micro_ros_setup \
 && cd .. \
 && source /opt/ros/${ROS_DISTRO}/local_setup.bash \
 && rm /etc/ros/rosdep/sources.list.d/20-default.list \
 && rosdep init \
 && rosdep update \
 && rosdep install --from-paths src --ignore-src -r -y \
 && colcon build

# Install additional dependencies
RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-plot \
    python3-tk \
    psmisc

RUN pip3 install --no-cache-dir lapx

# Make setup scripts run every time the shell starts
RUN echo 'git config --global --add safe.directory "*"' >> ~/.bashrc \
    && echo 'git config --global user.email "jetson.service@gmail.com"' >> ~/.bashrc \
    && echo 'git config --global user.email "jetson-service"' >> ~/.bashrc \
    && echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> ~/.bashrc \
    && echo 'source "${WS_DIR_YOLOV8}/install/local_setup.sh"' >> ~/.bashrc \
    && echo 'source "${WS_DIR_MICROROS}/install/local_setup.sh"' >> ~/.bashrc \
    && echo 'source "${WS_DIR}/install/local_setup.sh"' >> ~/.bashrc

RUN cd /librealsense/build && make install

ENV DEBIAN_FRONTEND=dialog

WORKDIR /home/ultraviolet

CMD ["/bin/bash"]
