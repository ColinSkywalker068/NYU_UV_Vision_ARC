ARG BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt
FROM ${BASE_IMAGE}

# Update ROS2 GPG key
RUN apt-get install curl \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" | sudo tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install Python
RUN apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev && apt-get update && apt-get clean all

# GStreamer + gst-python
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3-gi python3-gst-1.0 gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 gir1.2-gst-rtsp-server-1.0 \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav libgstrtspserver-1.0-0 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# Install build dependencies (Added libyaml-cpp-dev for DS 6.4)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libssl-dev libusb-1.0-0-dev libgtk-3-dev libglfw3-dev \
    libgl1-mesa-dev libglu1-mesa-dev libusb-1.0-0 udev \
    apt-transport-https ca-certificates curl software-properties-common \
    qtcreator libyaml-cpp-dev libjsoncpp-dev && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# Install runtime/user tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    vim screen bash-completion && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

# Build realsense library
ARG LIBREALSENSE_VERSION=development
RUN git clone --branch ${LIBREALSENSE_VERSION} --depth=1 https://github.com/IntelRealSense/librealsense \
    && cd librealsense \
    && mkdir build && cd build \
    && cmake \
    -DBUILD_EXAMPLES=true \
    -DFORCE_RSUSB_BACKEND=true \
    -DBUILD_WITH_CUDA=true \
    -DCMAKE_BUILD_TYPE=release \
    -DBUILD_PYTHON_BINDINGS=bool:true \
    -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    ../ \
    && make -j$(($(nproc)-1)) \
    && make install \
    && cd .. \
    && cp -r . /usr/local/ \
    && cp ./config/99-realsense-libusb.rules /etc/udev/rules.d/ \
    && cp ./config/99-realsense-d4xx-mipi-dfu.rules /etc/udev/rules.d/ 

ENV DEBIAN_FRONTEND=noninteractive

# Move base image's custom ROS2 installation
RUN mv /opt/ros/humble/install/* /opt/ros/humble/ \
    && rm -r /opt/ros/humble/install

# Realsense ROS
ENV WS_DIR_REALSENSE="/ros2_realsense_ws"
WORKDIR ${WS_DIR_REALSENSE}
RUN bash -c "apt-get update -y \
    && mkdir src && cd src \
    && git clone https://github.com/IntelRealSense/realsense-ros.git -b ros2-development \
    && cd .. \
    && apt-get install -y python3-rosdep \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && rm /etc/ros/rosdep/sources.list.d/20-default.list \
    && rosdep init && rosdep update \
    && rosdep install -i --from-path src --rosdistro ${ROS_DISTRO} --skip-keys=librealsense2 -y \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build"
RUN bash -c "source ./install/local_setup.sh"

# Install application dependencies
RUN pip3 install ultralytics --no-cache-dir --no-deps \
    && pip3 install --no-cache-dir py-cpuinfo psutil scipy seaborn thop tqdm pandas onnxsim lapx \
    && pip3 install --no-cache-dir --upgrade matplotlib gitpython \
    && pip3 install --no-cache-dir pyserial

RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-rqt ros-${ROS_DISTRO}-rqt-plot psmisc

# Run commands when shell starts
RUN echo 'git config --global --add safe.directory "*"' >> ~/.bashrc \
    && echo 'git config --global user.email "jetson.service@gmail.com"' >> ~/.bashrc \
    && echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> ~/.bashrc \
    && echo 'source "${WS_DIR_REALSENSE}/install/local_setup.sh"' >> ~/.bashrc

# Fix realsense error (Now this works because we didn't delete the folder earlier)
RUN cd /librealsense/build && make install && cd / && rm -rf /librealsense

ENV DEBIAN_FRONTEND=dialog

# --- CRITICAL FIXES FOR VPI AND DEEPSTREAM START HERE ---

# 1. Install libnvvpi3 (Corrected for JetPack 6.0 / R36.3)
RUN apt-get update && apt-get install -y gnupg curl \
    && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc | gpg --dearmor -o /usr/share/keyrings/jetson-ota-public.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/common r36.3 main" > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/t234 r36.3 main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && apt-get update \
    && apt-get install -y libnvvpi3

# 2. Install DeepStream 6.4
# We use apt-get install ./package.deb instead of dpkg to handle dependencies automatically.
# We also download via wget to avoid curl redirect issues.
RUN apt-get update && apt-get install -y wget && \
    wget --content-disposition 'https://api.ngc.nvidia.com/v2/resources/org/nvidia/deepstream/6.4/files?redirect=true&path=deepstream-6.4_6.4.0-1_arm64.deb' -O /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    apt-get install -y /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    rm -f /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    ldconfig

# Expose DeepStream paths
ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins \
    GST_PLUGIN_PATH_1_0=/opt/nvidia/deepstream/deepstream/lib/gst-plugins \
    LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib:/usr/lib/aarch64-linux-gnu/tegra:${LD_LIBRARY_PATH}

WORKDIR /home/ultraviolet/CV_Detection
CMD ["/bin/bash"]
