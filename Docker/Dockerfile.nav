FROM ros:humble-perception

# Install Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev && apt-get update && apt-get clean all

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev \
    libusb-1.0-0-dev \
    libgtk-3-dev \
    libglfw3-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libusb-1.0-0 \
    udev \
    apt-transport-https \
    ca-certificates \
    software-properties-common \
    qtcreator && \
    rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Build Realsense library
# https://github.com/IntelRealSense/librealsense/issues/11931
ARG LIBREALSENSE_VERSION=development
RUN git clone --branch ${LIBREALSENSE_VERSION} --depth=1 https://github.com/IntelRealSense/librealsense \
    && cd librealsense \
    && mkdir build \
    && cd build \
    && cmake \
    -DBUILD_EXAMPLES=true \
    -DFORCE_RSUSB_BACKEND=true \
    -DCMAKE_BUILD_TYPE=release \
    -DBUILD_PYTHON_BINDINGS=bool:true \
    -DPYTHON_EXECUTABLE=/usr/bin/python3 \
    ../ \
    && make -j$(($(nproc)-1)) \
    && make install \
    && cd .. \
    && cp -r . /usr/local/ \
    && cp ./config/99-realsense-libusb.rules /etc/udev/rules.d/ \
    && cp ./config/99-realsense-d4xx-mipi-dfu.rules /etc/udev/rules.d/ \
    && rm -rf librealsense

ENV DEBIAN_FRONTEND=noninteractive

# Build Realsense ROS: https://github.com/IntelRealSense/realsense-ros/tree/ros2-development
ENV WS_DIR_REALSENSE="/ros2_realsense_ws"
WORKDIR ${WS_DIR_REALSENSE}
RUN bash -c "apt-get update -y \
    && mkdir src \
    && cd src \
    && git clone https://github.com/IntelRealSense/realsense-ros.git -b ros2-development \
    && cd .. \
    && apt-get install -y python3-rosdep \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && rm /etc/ros/rosdep/sources.list.d/20-default.list \
    && rosdep init \
    && rosdep update \
    && rosdep install -i --from-path src --rosdistro ${ROS_DISTRO} --skip-keys=librealsense2 -y \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build"

# Install application dependencies
RUN pip3 install \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cpu

RUN pip3 install --no-cache-dir lapx \
    onnxruntime==1.16.3 \
    opencv-python==4.8.1.78 \
    py-cpuinfo \
    psutil \
    scipy \
    seaborn \
    thop \
    tqdm \
    pandas \
    onnxsim

RUN pip3 install ultralytics --no-cache-dir --no-deps \
    && pip3 install --no-cache-dir --upgrade matplotlib gitpython

RUN apt-get update && apt-get install -y \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-plot \
    ros-${ROS_DISTRO}-rqt-common-plugins \
    ros-${ROS_DISTRO}-slam-toolbox \
    ros-${ROS_DISTRO}-cartographer \
    ros-${ROS_DISTRO}-cartographer-ros \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-rplidar-ros \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-laser-geometry \
    ros-${ROS_DISTRO}-pointcloud-to-laserscan \
    ros-${ROS_DISTRO}-tf2-tools \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-twist-mux \
    ros-${ROS_DISTRO}-ros-gz \
    psmisc \
    && rm -rf /var/lib/apt/lists/*

# Install turtlebot
RUN apt-get update && apt-get install -y \
    ros-humble-turtlebot4-simulator \
    ros-humble-irobot-create-nodes \
    && rm -rf /var/lib/apt/lists/*

########################################
# Create ROS workspace
########################################
RUN mkdir -p /root/livox_ws/src
WORKDIR /root/livox_ws/src

########################################
# Install Livox SDK2
########################################
RUN git clone https://github.com/Livox-SDK/Livox-SDK2.git 

########################################
# Install livox_ros_driver2 (Mid-360)
########################################
RUN git clone https://github.com/Livox-SDK/livox_ros_driver2.git

########################################
# Install FAST_LIO
########################################
RUN git clone https://github.com/hku-mars/FAST_LIO.git

########################################
# Install FAST_LIO localization / mapping packages
########################################
RUN git clone https://github.com/koide3/ndt_omp.git

########################################
# Source workspace automatically
########################################
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /root/livox_ws/install/setup.bash" >> ~/.bashrc

# Fix numpy2 incompatibility with CV libraries
RUN pip3 install "numpy<2" --force-reinstall

# Run commands when shell starts
RUN echo 'git config --global --add safe.directory "*"' >> ~/.bashrc \
    && echo 'git config --global user.email "jetson.service@gmail.com"' >> ~/.bashrc \
    && echo 'git config --global user.email "jetson-service"' >> ~/.bashrc \
    && echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> ~/.bashrc \
    && echo 'source "${WS_DIR_REALSENSE}/install/local_setup.sh"' >> ~/.bashrc

RUN cd /librealsense/build && make install

ENV DEBIAN_FRONTEND=dialog

WORKDIR /home/ultraviolet

CMD ["/bin/bash"]


