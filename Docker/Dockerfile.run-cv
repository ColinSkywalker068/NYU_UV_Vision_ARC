ARG BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-cplusplus
FROM ${BASE_IMAGE}

# Set the working directory to simplify the commands in the ENTRYPOINT
WORKDIR /home/ultraviolet/CV_Detection

# The ENTRYPOINT contains the full sequence of commands to run on container start
ENTRYPOINT ["/bin/bash", "-c", "set -e; \
    echo '--- Sourcing ROS 2 environment (if exists) ---'; \
    source install/setup.bash 2>/dev/null || echo 'install/setup.bash not found, will create after build'; \
    echo '--- Step 1: Running uv clean ---'; \
    uv clean; \
    echo '--- Step 2: Running uv build ---'; \
    uv build; \
    echo '--- Step 3: Running yolo_cpp ---'; \
    uv run yolo_cpp realsense.launch.py show:=false"]
