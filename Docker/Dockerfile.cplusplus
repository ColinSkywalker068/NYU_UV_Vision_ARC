ARG BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-realsense-wrapper-ultra
FROM ${BASE_IMAGE}
ARG PYLON_PACKAGE=""

# C++ DeepStream image:
# - keeps the original Python/ROS image intact
# - adds the Basler + DeepStream runtime needed by yolo_cpp
ENV DEBIAN_FRONTEND=noninteractive

# Core runtime and build dependencies for the C++ DeepStream path.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gnupg curl wget rsync \
    python3 python3-pip python3-dev \
    python3-gi python3-gst-1.0 gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 gir1.2-gst-rtsp-server-1.0 \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav libgstrtspserver-1.0-0 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libssl-dev libusb-1.0-0-dev libgtk-3-dev libglfw3-dev \
    libgl1-mesa-dev libglu1-mesa-dev libusb-1.0-0 udev \
    apt-transport-https ca-certificates software-properties-common \
    qtcreator libyaml-cpp-dev libjsoncpp-dev \
    vim screen bash-completion psmisc && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Install libnvvpi3 from the Jetson repo so DeepStream can load cleanly.
RUN apt-get update && apt-get install -y gnupg curl && \
    mkdir -p /usr/share/keyrings && \
    curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/jetson-ota-public.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/common r36.3 main" \
    > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/t234 r36.3 main" \
    >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    apt-get update && \
    apt-get install -y libnvvpi3

# Install DeepStream 6.4.
RUN apt-get update && apt-get install -y wget && \
    wget --content-disposition \
    'https://api.ngc.nvidia.com/v2/resources/org/nvidia/deepstream/6.4/files?redirect=true&path=deepstream-6.4_6.4.0-1_arm64.deb' \
    -O /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    apt-get install -y /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    rm -f /tmp/deepstream-6.4_6.4.0-1_arm64.deb && \
    ldconfig

# DeepStream install helper for plugin symlinks and cache.
WORKDIR /opt/nvidia/deepstream/deepstream
RUN ./install.sh && ldconfig
RUN rm -rf /root/.cache/gstreamer-1.0/

ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins:/opt/pylon/lib/gstreamer-1.0:/opt/pylon/lib/gst-plugins \
    GST_PLUGIN_PATH_1_0=/opt/nvidia/deepstream/deepstream/lib/gst-plugins:/opt/pylon/lib/gstreamer-1.0:/opt/pylon/lib/gst-plugins \
    LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib:/usr/lib/aarch64-linux-gnu/tegra:${LD_LIBRARY_PATH}

COPY pylon/ /tmp/pylon-packages/

# Basler Pylon SDK is expected to be present at /opt/pylon.
# If you have a local Basler package archive or .deb, pass it via:
#   docker build --build-arg PYLON_PACKAGE=pylon_xxx.tar.gz ...
# The file must exist under Docker/pylon/ in the build context.
RUN if [ -n "${PYLON_PACKAGE}" ]; then \
      PYLON_PACKAGE_BASENAME="$(basename "${PYLON_PACKAGE}")" && \
      if [ ! -f "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" ]; then \
        echo "PYLON_PACKAGE was set to '${PYLON_PACKAGE}', but that file was not found in the build context." >&2; \
        echo "Files available under Docker/pylon/:" >&2; \
        find /tmp/pylon-packages -maxdepth 1 -type f -printf '  %f\n' >&2 || true; \
        exit 1; \
      fi; \
      case "${PYLON_PACKAGE_BASENAME}" in \
        *.deb) \
          apt-get update && \
          apt-get install -y "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" && \
          rm -rf /var/lib/apt/lists/* && \
          ldconfig; \
          ;; \
        *.tar.gz|*.tgz) \
          mkdir -p /tmp/pylon && \
          tar -xzf "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" -C /tmp/pylon --strip-components=1 && \
          PYLON_INSTALLER="$(find /tmp/pylon -maxdepth 2 -type f \( -name 'install*.sh' -o -name 'setup*.sh' \) | head -n 1)" && \
          if [ -n "${PYLON_INSTALLER}" ]; then \
            chmod +x "${PYLON_INSTALLER}" && \
            "${PYLON_INSTALLER}" --accept-eula --default; \
          elif [ -f /tmp/pylon/include/pylon/PylonIncludes.h ] && find /tmp/pylon -maxdepth 3 -type f -name 'libpylonbase.so*' | grep -q .; then \
            mkdir -p /opt/pylon && \
            cp -a /tmp/pylon/. /opt/pylon/; \
          else \
            echo "Could not find a Pylon installer or extracted SDK layout inside ${PYLON_PACKAGE_BASENAME}." >&2; \
            echo "Top-level extracted files:" >&2; \
            find /tmp/pylon -maxdepth 2 -type f -printf '  %P\n' >&2 | head -n 40; \
            exit 1; \
          fi && \
          test -f /opt/pylon/include/pylon/PylonIncludes.h && \
          find /opt/pylon -maxdepth 3 -type f -name 'libpylonbase.so*' | grep -q . && \
          rm -rf /tmp/pylon && \
          ldconfig; \
          ;; \
        *) \
          echo "Unsupported PYLON_PACKAGE format: ${PYLON_PACKAGE}. Use .deb or .tar.gz." >&2; \
          exit 1; \
          ;; \
      esac; \
    else \
      echo "PYLON_PACKAGE not provided; expecting /opt/pylon to be mounted before colcon build."; \
    fi

ENV PYLON_ROOT=/opt/pylon
ENV PATH=$PATH:$PYLON_ROOT/bin
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PYLON_ROOT/lib

# Keep this late so kmod/plugin-path tweaks do not invalidate the heavy DeepStream layers.
RUN apt-get update && \
    apt-get install -y --no-install-recommends kmod && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /root/.cache/gstreamer-1.0/ && \
    (gst-inspect-1.0 pylonsrc >/dev/null 2>&1 || \
      (echo "WARNING: GStreamer element 'pylonsrc' is not available. The Pylon SDK is installed, but this archive may not include Basler's GStreamer plugin." >&2 && \
       echo "         DeepStream camera_type=basler requires pylonsrc unless source_element is changed." >&2 && \
       find /opt/pylon -maxdepth 4 -iname '*gst*' -o -iname '*pylon*.so*' | sort | head -n 80 >&2))

WORKDIR /home/ultraviolet/CV_Detection
CMD ["/bin/bash"]
