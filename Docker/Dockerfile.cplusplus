ARG BASE_IMAGE=nyuultraviolet/cv-dockerfile:jp60-pytorch21-humble-tensorrt-realsense-wrapper-ultra
FROM ${BASE_IMAGE}
ARG PYLON_PACKAGE=""
# JetPack 6.0 GA / L4T 36.3 requires DeepStream 7.0.
ARG DEEPSTREAM_VERSION=7.0
ARG DEEPSTREAM_DEB_VERSION=7.0.0-1

# C++ DeepStream image:
# - keeps the original Python/ROS image intact
# - adds the Basler + DeepStream runtime needed by yolo_cpp
ENV DEBIAN_FRONTEND=noninteractive

# Core runtime and build dependencies for the C++ DeepStream path.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gnupg curl wget rsync \
    python3 python3-pip python3-dev \
    python3-gi python3-gst-1.0 gir1.2-gstreamer-1.0 \
    gir1.2-gst-plugins-base-1.0 gir1.2-gst-rtsp-server-1.0 \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav libgstrtspserver-1.0-0 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libssl-dev libusb-1.0-0-dev libgtk-3-dev libglfw3-dev \
    libgl1-mesa-dev libglu1-mesa-dev libusb-1.0-0 udev \
    apt-transport-https ca-certificates software-properties-common \
    qtcreator libyaml-cpp-dev libjsoncpp-dev \
    vim screen bash-completion psmisc && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Install libnvvpi3 from the Jetson repo so DeepStream can load cleanly.
RUN apt-get update && apt-get install -y gnupg curl && \
    mkdir -p /usr/share/keyrings && \
    curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/jetson-ota-public.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/common r36.3 main" \
    > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    echo "deb [signed-by=/usr/share/keyrings/jetson-ota-public.gpg] https://repo.download.nvidia.com/jetson/t234 r36.3 main" \
    >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    apt-get update && \
    apt-get install -y libnvvpi3

# Install the DeepStream release matched to the host JetPack.
RUN apt-get update && apt-get install -y wget && \
    if [ "${DEEPSTREAM_VERSION}" != "6.4" ] && dpkg-query -W deepstream-6.4 >/dev/null 2>&1; then apt-get remove -y deepstream-6.4; fi && \
    wget --content-disposition \
    "https://api.ngc.nvidia.com/v2/resources/org/nvidia/deepstream/${DEEPSTREAM_VERSION}/files?redirect=true&path=deepstream-${DEEPSTREAM_VERSION}_${DEEPSTREAM_DEB_VERSION}_arm64.deb" \
    -O /tmp/deepstream.deb && \
    apt-get install -y /tmp/deepstream.deb && \
    rm -f /tmp/deepstream.deb && \
    ldconfig

# DeepStream install helper for plugin symlinks and cache.
WORKDIR /opt/nvidia/deepstream/deepstream
RUN ./install.sh && ldconfig
RUN rm -rf /root/.cache/gstreamer-1.0/

ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream-${DEEPSTREAM_VERSION}/lib/gst-plugins:/opt/nvidia/deepstream/deepstream/lib/gst-plugins:/usr/lib/aarch64-linux-gnu/gstreamer-1.0:/opt/pylon/lib/gstreamer-1.0:/opt/pylon/lib/gst-plugins \
    GST_PLUGIN_PATH_1_0=/opt/nvidia/deepstream/deepstream-${DEEPSTREAM_VERSION}/lib/gst-plugins:/opt/nvidia/deepstream/deepstream/lib/gst-plugins:/usr/lib/aarch64-linux-gnu/gstreamer-1.0:/opt/pylon/lib/gstreamer-1.0:/opt/pylon/lib/gst-plugins \
    LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream-${DEEPSTREAM_VERSION}/lib:/opt/nvidia/deepstream/deepstream/lib:/usr/lib/aarch64-linux-gnu/tegra:/usr/lib/aarch64-linux-gnu/nvidia:/usr/local/cuda/lib64:/usr/local/cuda/compat:/usr/lib/aarch64-linux-gnu

COPY pylon/ /tmp/pylon-packages/

# Basler Pylon SDK is expected to be present at /opt/pylon.
# If you have a local Basler package archive or .deb, pass it via:
#   docker build --build-arg PYLON_PACKAGE=pylon_xxx.tar.gz ...
# The file must exist under Docker/pylon/ in the build context.
RUN if [ -n "${PYLON_PACKAGE}" ]; then \
      PYLON_PACKAGE_BASENAME="$(basename "${PYLON_PACKAGE}")" && \
      if [ ! -f "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" ]; then \
        echo "PYLON_PACKAGE was set to '${PYLON_PACKAGE}', but that file was not found in the build context." >&2; \
        echo "Files available under Docker/pylon/:" >&2; \
        find /tmp/pylon-packages -maxdepth 1 -type f -printf '  %f\n' >&2 || true; \
        exit 1; \
      fi; \
      case "${PYLON_PACKAGE_BASENAME}" in \
        *.deb) \
          apt-get update && \
          apt-get install -y "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" && \
          rm -rf /var/lib/apt/lists/* && \
          ldconfig; \
          ;; \
        *.tar.gz|*.tgz) \
          mkdir -p /tmp/pylon && \
          tar -xzf "/tmp/pylon-packages/${PYLON_PACKAGE_BASENAME}" -C /tmp/pylon --strip-components=1 && \
          PYLON_NESTED_PACKAGE="$(find /tmp/pylon -maxdepth 2 -type f \( -name 'pylon*.tar.gz' -o -name 'pylon*.tgz' \) | head -n 1)" && \
          if [ ! -f /tmp/pylon/include/pylon/PylonIncludes.h ] && [ -n "${PYLON_NESTED_PACKAGE}" ]; then \
            mkdir -p /tmp/pylon-inner && \
            tar -xzf "${PYLON_NESTED_PACKAGE}" -C /tmp/pylon-inner --strip-components=1 && \
            rm -rf /tmp/pylon && \
            mv /tmp/pylon-inner /tmp/pylon; \
          fi && \
          PYLON_INSTALLER="$(find /tmp/pylon -maxdepth 2 -type f \( -name 'install*.sh' -o -name 'setup*.sh' -o -name 'pylon-setup*.sh' \) ! -name 'pylon-setup-env.sh' | head -n 1)" && \
          if [ -n "${PYLON_INSTALLER}" ]; then \
            chmod +x "${PYLON_INSTALLER}" && \
            "${PYLON_INSTALLER}" --accept-eula --default; \
          elif [ -f /tmp/pylon/include/pylon/PylonIncludes.h ] && find /tmp/pylon -maxdepth 3 -type f -name 'libpylonbase.so*' | grep -q .; then \
            mkdir -p /opt/pylon && \
            cp -a /tmp/pylon/. /opt/pylon/; \
          else \
            echo "Could not find a Pylon installer or extracted SDK layout inside ${PYLON_PACKAGE_BASENAME}." >&2; \
            echo "Top-level extracted files:" >&2; \
            find /tmp/pylon -maxdepth 2 -type f -printf '  %P\n' >&2 | head -n 40; \
            exit 1; \
          fi && \
          test -f /opt/pylon/include/pylon/PylonIncludes.h && \
          find /opt/pylon -maxdepth 3 -type f -name 'libpylonbase.so*' | grep -q . && \
          rm -rf /tmp/pylon && \
          ldconfig; \
          ;; \
        *) \
          echo "Unsupported PYLON_PACKAGE format: ${PYLON_PACKAGE}. Use .deb or .tar.gz." >&2; \
          exit 1; \
          ;; \
      esac; \
    else \
      echo "PYLON_PACKAGE not provided; expecting /opt/pylon to be mounted before colcon build."; \
    fi

ENV PYLON_ROOT=/opt/pylon
ENV PATH=$PATH:$PYLON_ROOT/bin
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PYLON_ROOT/lib

# Keep this late so kmod/plugin-path tweaks do not invalidate the heavy DeepStream layers.
ARG PYLON_GSTREAMER_PACKAGE=""
RUN apt-get update && \
    apt-get install -y --no-install-recommends kmod && \
    install_pylon_gstreamer_deb() { \
      PYLON_GSTREAMER_DEB="$1"; \
      PYLON_DEB_DEP_VERSION="$(dpkg-deb -f "${PYLON_GSTREAMER_DEB}" Depends 2>/dev/null | tr ',' '\n' | sed -n 's/^ *pylon *(= *\([^)]*\)).*/\1/p' | head -n 1)"; \
      if [ -z "${PYLON_DEB_DEP_VERSION}" ] && dpkg-deb -f "${PYLON_GSTREAMER_DEB}" Depends 2>/dev/null | tr ',' '\n' | grep -Eq '^ *pylon($|[ (])'; then \
        PYLON_DEB_DEP_VERSION="9999.0"; \
      fi; \
      if [ -n "${PYLON_DEB_DEP_VERSION}" ] && ! dpkg-query -W -f='${Version}' pylon >/dev/null 2>&1; then \
        mkdir -p /tmp/pylon-dummy/DEBIAN && \
        printf 'Package: pylon\nVersion: %s\nSection: misc\nPriority: optional\nArchitecture: %s\nMaintainer: CV Detection <none>\nDescription: Dummy pylon package for tar-installed Basler SDK\n The Basler pylon SDK is installed under /opt/pylon from the upstream tarball.\n' "${PYLON_DEB_DEP_VERSION}" "$(dpkg --print-architecture)" > /tmp/pylon-dummy/DEBIAN/control && \
        dpkg-deb --build /tmp/pylon-dummy /tmp/pylon-dummy.deb >/dev/null && \
        dpkg -i /tmp/pylon-dummy.deb && \
        rm -rf /tmp/pylon-dummy /tmp/pylon-dummy.deb; \
      fi; \
      apt-get install -y --no-install-recommends "${PYLON_GSTREAMER_DEB}"; \
    } && \
    if [ -n "${PYLON_GSTREAMER_PACKAGE}" ]; then \
      PYLON_GSTREAMER_BASENAME="$(basename "${PYLON_GSTREAMER_PACKAGE}")" && \
      if [ ! -f "/tmp/pylon-packages/${PYLON_GSTREAMER_BASENAME}" ]; then \
        echo "PYLON_GSTREAMER_PACKAGE was set to '${PYLON_GSTREAMER_PACKAGE}', but that file was not found in Docker/pylon/." >&2; \
        echo "Files available under Docker/pylon/:" >&2; \
        find /tmp/pylon-packages -maxdepth 1 -type f -printf '  %f\n' >&2 || true; \
        exit 1; \
      fi; \
      case "${PYLON_GSTREAMER_BASENAME}" in \
        *.deb) \
          install_pylon_gstreamer_deb "/tmp/pylon-packages/${PYLON_GSTREAMER_BASENAME}"; \
          ;; \
        *.tar.gz|*.tgz) \
          mkdir -p /tmp/pylon-gst && \
          tar -xzf "/tmp/pylon-packages/${PYLON_GSTREAMER_BASENAME}" -C /tmp/pylon-gst && \
          PYLON_GSTREAMER_DEBS="$(find /tmp/pylon-gst -type f -name '*.deb' -print)" && \
          if [ -z "${PYLON_GSTREAMER_DEBS}" ]; then \
            echo "Could not find any .deb files inside ${PYLON_GSTREAMER_BASENAME}." >&2; \
            exit 1; \
          fi && \
          for deb in ${PYLON_GSTREAMER_DEBS}; do \
            install_pylon_gstreamer_deb "${deb}"; \
          done && \
          rm -rf /tmp/pylon-gst; \
          ;; \
        *) \
          echo "Unsupported PYLON_GSTREAMER_PACKAGE format: ${PYLON_GSTREAMER_PACKAGE}. Use .deb or .tar.gz containing .deb files." >&2; \
          exit 1; \
          ;; \
      esac; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /root/.cache/gstreamer-1.0/ && \
    for required_element in nvstreammux nvinfer nvvideoconvert appsink; do \
      if ! gst-inspect-1.0 "${required_element}" >/dev/null 2>&1; then \
        echo "WARNING: Required DeepStream/GStreamer element '${required_element}' is not available during docker build." >&2; \
        echo "         On Jetson, some DeepStream plugins need host NVIDIA driver libraries mounted by docker run --runtime nvidia." >&2; \
        echo "GST_PLUGIN_PATH=${GST_PLUGIN_PATH}" >&2; \
        echo "DeepStream plugin files:" >&2; \
        find /opt/nvidia/deepstream -type f \( -iname '*infer*.so' -o -iname '*streammux*.so' -o -iname '*convert*.so' \) 2>/dev/null | sort >&2; \
        CANDIDATE_PLUGIN="$(find /opt/nvidia/deepstream -type f \( -iname '*infer*.so' -o -iname '*streammux*.so' -o -iname '*convert*.so' \) 2>/dev/null | head -n 1)" && \
        if [ -n "${CANDIDATE_PLUGIN}" ]; then \
          echo "ldd for candidate plugin ${CANDIDATE_PLUGIN}:" >&2; \
          ldd "${CANDIDATE_PLUGIN}" >&2 || true; \
        fi; \
      fi; \
    done && \
    if ! gst-inspect-1.0 pylonsrc >/dev/null 2>&1; then \
      echo "WARNING: GStreamer element 'pylonsrc' is not available." >&2; \
      echo "         DeepStream camera_type=basler requires pylonsrc unless source_element is changed." >&2; \
      echo "Installed gst-plugin-pylon files:" >&2; \
      dpkg -L gst-plugin-pylon >&2 || true; \
      PYLON_GST_PLUGIN="$(find /usr/lib /opt/pylon -type f \( -iname '*pylon*.so' -o -iname 'libgst*.so' \) 2>/dev/null | grep -Ei 'gst.*pylon|pylon.*gst' | head -n 1)" && \
      if [ -n "${PYLON_GST_PLUGIN}" ]; then \
        echo "Candidate plugin: ${PYLON_GST_PLUGIN}" >&2; \
        ldd "${PYLON_GST_PLUGIN}" >&2 || true; \
        GST_DEBUG=GST_PLUGIN_LOADING:6 gst-inspect-1.0 "${PYLON_GST_PLUGIN}" >&2 || true; \
      fi; \
      echo "Pylon SDK libraries:" >&2; \
      find /opt/pylon -maxdepth 3 -iname 'libpylonbase.so*' -o -iname 'libpylonutility.so*' | sort >&2; \
      if [ -n "${PYLON_GSTREAMER_PACKAGE}" ]; then \
        echo "PYLON_GSTREAMER_PACKAGE was provided, so failing the build because pylonsrc did not load." >&2; \
        exit 1; \
      fi; \
    fi

WORKDIR /home/ultraviolet/CV_Detection
CMD ["/bin/bash"]
